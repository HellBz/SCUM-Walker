{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCUM Walker",
  "version": "0.7.8",
  "identifier": "com.scumwalker.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SCUM Walker",
        "width": 1400,
        "height": 1000,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDOUJDQzBFQTY4MjZCMTgKUldRWWE0S21Ec3liZkdFcHV1Rnl1WEowdXJGYjFqRmQ4Y2x6UjA1WEtYTTNweTlsQ0NXdG1uRjkK",
      "endpoints": [
        "https://github.com/HellBz/SCUM-Walker/releases/latest/download/latest.json"
      ]
    }
  }
}
